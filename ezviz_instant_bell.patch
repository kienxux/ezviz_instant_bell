@@ -0,0 +1,88 @@
+blueprint:
+  name: Doorbell ring as a persistent notification
+  description: >
+    When the doorbell rings, waits for the picture and shows a persistent
+    notification in Home Assistant with the picture link. The notification stays
+    until you dismiss it (or until the time set below), so a ring is not lost if
+    you miss the phone notification. It never opens the door: a persistent
+    notification has no button to tap, so use the ring notification blueprint
+    if you want an "Open door" button.
+  domain: automation
+  input:
+    bell:
+      name: Doorbell event
+      selector:
+        entity:
+          filter:
+            - integration: ezviz_instant_bell
+              domain: event
+    picture:
+      name: Last picture
+      selector:
+        entity:
+          filter:
+            - integration: ezviz_instant_bell
+              domain: image
+    picture_wait:
+      name: Seconds to wait for the picture
+      default: 10
+      selector:
+        number:
+          min: 0
+          max: 30
+          unit_of_measurement: s
+    auto_dismiss:
+      name: Seconds before the notification goes away
+      description: >
+        0 keeps the notification until you dismiss it yourself.
+      default: 0
+      selector:
+        number:
+          min: 0
+          max: 3600
+          unit_of_measurement: s
+
+mode: restart
+
+variables:
+  bell_entity: !input bell
+  picture_entity: !input picture
+  auto_dismiss: !input auto_dismiss
+
+triggers:
+  - trigger: state
+    entity_id: !input bell
+
+conditions:
+  # A ring. "Unavailable -> restored state" happens at startup and is not a ring;
+  # "unknown -> ring" is the very first ring of a new entity and is one.
+  - condition: template
+    value_template: >
+      {{ trigger.to_state.attributes.event_type == 'ring'
+         and trigger.from_state is not none
+         and trigger.from_state.state != 'unavailable' }}
+
+actions:
+  - variables:
+      ring_time: "{{ trigger.to_state.last_changed.timestamp() }}"
+  - wait_template: "{{ states[picture_entity].last_changed.timestamp() > ring_time }}"
+    timeout:
+      seconds: !input picture_wait
+    continue_on_timeout: true
+  - action: persistent_notification.create
+    data:
+      notification_id: ezviz_instant_bell_ring
+      title: Someone is at the door
+      message: >
+        The doorbell rang.
+        Picture: {{ state_attr(picture_entity, 'entity_picture') }}
+  - choose:
+      - conditions:
+          - condition: template
+            value_template: "{{ auto_dismiss > 0 }}"
+        sequence:
+          - delay:
+              seconds: !input auto_dismiss
+          - action: persistent_notification.dismiss
+            data:
+              notification_id: ezviz_instant_bell_ring
diff --git a/blueprints/automation/ezviz_instant_bell/ring_speaker_announcement.yaml b/blueprints/automation/ezviz_instant_bell/ring_speaker_announcement.yaml
